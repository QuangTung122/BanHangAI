# Secret key for JSON Web Token authentication
JWT_SECRET=your_jwt_secret_here

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Đăng ký Bot: demo bỏ qua OTP trong development; production cần chọn sms và cấu hình cổng gửi.
BOT_OTP_MODE=demo
# Cổng SMS nhận POST JSON {"to":"09xxxxxxxx","message":"..."} và trả mã HTTP 2xx.
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
# Secret riêng tối thiểu 32 ký tự ngẫu nhiên cho chế độ SMS; không dùng JWT_SECRET thay thế.
BOT_OTP_SECRET=
